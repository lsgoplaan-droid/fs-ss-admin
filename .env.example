# =============================================================================
# fs-ss-admin — Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local to version control.
# =============================================================================

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL="postgresql://user:password@localhost:5432/fs_ss_admin_dev"

# =============================================================================
# AUTH — JWT
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# =============================================================================
JWT_ACCESS_SECRET="replace-with-64-byte-hex-secret"
JWT_REFRESH_SECRET="replace-with-different-64-byte-hex-secret"
# Access token lifetime in seconds (default: 28800 = 8 hours)
JWT_ACCESS_TTL_SECONDS="28800"
# Refresh token lifetime in seconds (default: 604800 = 7 days)
JWT_REFRESH_TTL_SECONDS="604800"
# Impersonation token lifetime in seconds (default: 1800 = 30 min, non-renewable)
JWT_IMPERSONATION_TTL_SECONDS="1800"

# =============================================================================
# ENCRYPTION — Gateway API keys are encrypted at rest with AES-256-GCM
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 32 bytes (64 hex chars) for AES-256.
# Key rotation procedure: see docs/encryption-rotation.md
# Phase 1.5: migrate to AWS KMS (see TODOS T3)
# =============================================================================
ENCRYPTION_MASTER_KEY="replace-with-32-byte-hex-key-64-chars-long-exactly"

# =============================================================================
# REDIS — Session registry + rate limiting (upstash)
# Phase 1: Upstash Redis (serverless-compatible)
# =============================================================================
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# =============================================================================
# EMAIL — AWS SES
# =============================================================================
AWS_SES_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
# Verified sender identity in SES
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_FROM_NAME="Matrix Emart Admin"

# =============================================================================
# PAYMENT GATEWAY SANDBOX CREDENTIALS (for QA/testing only)
# Live credentials are stored encrypted in the database — never in env vars.
# =============================================================================
# Razorpay test keys (from https://dashboard.razorpay.com)
RAZORPAY_TEST_KEY_ID="rzp_test_xxxxxxxxxx"
RAZORPAY_TEST_KEY_SECRET="your-razorpay-test-secret"

# Cashfree test keys (from https://merchant.cashfree.com)
CASHFREE_TEST_APP_ID="your-cashfree-test-app-id"
CASHFREE_TEST_SECRET_KEY="your-cashfree-test-secret"

# Juspay: Phase 1.5 — omit for Phase 1
# JUSPAY_TEST_API_KEY="your-juspay-test-key"
# JUSPAY_TEST_MERCHANT_ID="your-juspay-merchant-id"

# =============================================================================
# APP
# =============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# =============================================================================
# RATE LIMITING (upstash — same Redis instance)
# =============================================================================
# Max login attempts per IP per minute
RATE_LIMIT_LOGIN_PER_MIN="10"
# Max refresh attempts per IP per minute
RATE_LIMIT_REFRESH_PER_MIN="30"
# Max gateway test calls per tenant per minute
RATE_LIMIT_GATEWAY_TEST_PER_MIN="5"
